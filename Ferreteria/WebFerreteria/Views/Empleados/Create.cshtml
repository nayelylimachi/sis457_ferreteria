@model WebFerreteria.Models.Empleado

@{
    ViewData["Title"] = "Crear Empleados";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="card rounded shadow">
        <div class="card-body p-4">
            <h1 class="card-title fw-bold mb-4">Crear Empleado</h1>
            <hr class="mb-4" />

            <div class="row">
                <div class="col-md-8 offset-md-2 col-lg-6 offset-lg-3">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="form-group mb-3">
                            <label asp-for="CedulaIdentidad" class="form-label fw-bold"></label>
                            <input asp-for="CedulaIdentidad" class="form-control" />
                            <span asp-validation-for="CedulaIdentidad" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Nombre" class="form-label fw-bold"></label>
                            <input asp-for="Nombre" class="form-control" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="PrimerApellido" class="form-label fw-bold"></label>
                            <input asp-for="PrimerApellido" class="form-control" />
                            <span asp-validation-for="PrimerApellido" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="SegundoApellido" class="form-label fw-bold"></label>
                            <input asp-for="SegundoApellido" class="form-control" />
                            <span asp-validation-for="SegundoApellido" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Direccion" class="form-label fw-bold"></label>
                            <input asp-for="Direccion" class="form-control" />
                            <span asp-validation-for="Direccion" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Celular" class="form-label fw-bold"></label>
                            <input asp-for="Celular" class="form-control" />
                            <span asp-validation-for="Celular" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="Cargo" class="form-label fw-bold"></label>
                            <input asp-for="Cargo" class="form-control" />
                            <span asp-validation-for="Cargo" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 d-grid">
                                <button type="submit" class="btn btn-primary btn-lg">
                                    <i class="fa-solid fa-floppy-disk"></i> Crear
                                </button>
                            </div>
                            <div class="col-md-6 d-grid">
                                <a asp-action="Index" class="btn btn-secondary btn-lg">
                                    <i class="fa-solid fa-xmark"></i> Cancelar
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
