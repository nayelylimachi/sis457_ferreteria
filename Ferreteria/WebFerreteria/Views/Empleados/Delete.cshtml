@model WebFerreteria.Models.Empleado

@{
    ViewData["Title"] = "Eliminar Empleado";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="card border-danger shadow">
        <div class="card-body p-4">
            <h2 class="card-title fw-bold text-danger mb-4">
                <i class="fa-solid fa-triangle-exclamation"></i> Confirmar Eliminación
            </h2>
            <p class="mb-4 fs-5">¿Estás seguro que deseas eliminar este empleado?</p>
            <hr class="mb-4" />

            <dl class="row">
                <dt class="col-sm-4 fw-bold">Cédula de Identidad:</dt>
                <dd class="col-sm-8">@Model.CedulaIdentidad</dd>

                <dt class="col-sm-4 fw-bold">Nombre:</dt>
                <dd class="col-sm-8">@Model.Nombre</dd>

                <dt class="col-sm-4 fw-bold">Primer Apellido:</dt>
                <dd class="col-sm-8">@Model.PrimerApellido</dd>

                <dt class="col-sm-4 fw-bold">Segundo Apellido:</dt>
                <dd class="col-sm-8">@Model.SegundoApellido</dd>

                <dt class="col-sm-4 fw-bold">Dirección:</dt>
                <dd class="col-sm-8">@Model.Direccion</dd>

                <dt class="col-sm-4 fw-bold">Celular:</dt>
                <dd class="col-sm-8">@Model.Celular</dd>

                <dt class="col-sm-4 fw-bold">Cargo:</dt>
                <dd class="col-sm-8">@Model.Cargo</dd>

                <dt class="col-sm-4 fw-bold">Usuario Registro:</dt>
                <dd class="col-sm-8">@Model.UsuarioRegistro</dd>

                <dt class="col-sm-4 fw-bold">Fecha de Registro:</dt>
                <dd class="col-sm-8">@Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</dd>

                <dt class="col-sm-4 fw-bold">Estado:</dt>
                <dd class="col-sm-8">
                    @if (Model.Estado == 1)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactivo</span>
                    }
                </dd>
            </dl>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />

                <div class="row mt-4">
                    <div class="col-md-6 d-grid">
                        <button type="submit" class="btn btn-danger btn-lg">
                            <i class="fa-solid fa-trash"></i> Eliminar
                        </button>
                    </div>
                    <div class="col-md-6 d-grid">
                        <a asp-action="Index" class="btn btn-secondary btn-lg">
                            <i class="fa-solid fa-arrow-left"></i> Cancelar
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
