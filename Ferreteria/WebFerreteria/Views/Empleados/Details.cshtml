@model WebFerreteria.Models.Empleado

@{
    ViewData["Title"] = "Detalles de Empleado";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="card rounded shadow">
        <div class="card-body p-4">
            <h2 class="card-title fw-bold mb-4">Detalles del Empleado</h2>
            <hr class="mb-4" />

            <dl class="row">
                <dt class="col-sm-4 fw-bold">Cédula de Identidad:</dt>
                <dd class="col-sm-8">@Model.CedulaIdentidad</dd>

                <dt class="col-sm-4 fw-bold">Nombre:</dt>
                <dd class="col-sm-8">@Model.Nombre</dd>

                <dt class="col-sm-4 fw-bold">Primer Apellido:</dt>
                <dd class="col-sm-8">@Model.PrimerApellido</dd>

                <dt class="col-sm-4 fw-bold">Segundo Apellido:</dt>
                <dd class="col-sm-8">@Model.SegundoApellido</dd>

                <dt class="col-sm-4 fw-bold">Dirección:</dt>
                <dd class="col-sm-8">@Model.Direccion</dd>

                <dt class="col-sm-4 fw-bold">Celular:</dt>
                <dd class="col-sm-8">@Model.Celular</dd>

                <dt class="col-sm-4 fw-bold">Cargo:</dt>
                <dd class="col-sm-8">@Model.Cargo</dd>

                <dt class="col-sm-4 fw-bold">Usuario de Registro:</dt>
                <dd class="col-sm-8">@Model.UsuarioRegistro</dd>

                <dt class="col-sm-4 fw-bold">Fecha de Registro:</dt>
                <dd class="col-sm-8">@Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</dd>

                <dt class="col-sm-4 fw-bold">Estado:</dt>
                <dd class="col-sm-8">
                    @if (Model.Estado == 1)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactivo</span>
                    }
                </dd>
            </dl>

            <div class="row mt-4">
                <div class="col-md-6 d-grid">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-lg">
                        <i class="fa-solid fa-pen-to-square"></i> Editar
                    </a>
                </div>
                <div class="col-md-6 d-grid">
                    <a asp-action="Index" class="btn btn-secondary btn-lg">
                        <i class="fa-solid fa-arrow-left"></i> Volver a la Lista
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
