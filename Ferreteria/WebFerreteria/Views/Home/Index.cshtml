<!-- Contacto -->
<section class="page-section" id="contact">
    <div class="container">
        <div class="text-center">
            <h2 class="section-heading text-uppercase">Contáctenos</h2>
            <h3 class="section-subheading text-muted">Estamos para atender tus consultas y cotizaciones.</h3>
        </div>
        <div class="row">
            <div class="col-lg-5 mb-5 mb-lg-0">
                <div class="contact-info">
                    <div class="contact-item mb-4">
                        <i class="fas fa-map-marker-alt fa-2x text-primary mb-3"></i>
                        <h4 class="section-heading text-uppercase">Ubicación</h4>
                        <p class="text-muted">Av. Principal 1234, Local 5<br>Ciudad, Región</p>
                    </div>
                    <div class="contact-item mb-4">
                        <i class="fas fa-phone-alt fa-2x text-primary mb-3"></i>
                        <h4 class="section-heading text-uppercase">Teléfonos</h4>
                        <p class="text-muted">
                            Ventas: +591 78965432<br>
                            Servicio técnico: +591 78965412
                        </p>
                    </div>
                    <div class="contact-item">
                        <i class="fas fa-envelope fa-2x text-primary mb-3"></i>
                        <h4 class="section-heading text-uppercase">Correo Electrónico</h4>
                        <p class="text-muted">
                            ventas@ferreteriaejemplo.cl<br>
                            cotizaciones@ferreteriaejemplo.cl
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-lg-7">
                <form id="contactForm" data-sb-form-api-token="API_TOKEN">
                    <div class="row align-items-stretch mb-5">
                        <div class="col-md-6">
                            <div class="form-group mb-4">
                                <input class="form-control" id="nombre" type="text" placeholder="Nombre Completo *" required />
                                <div class="invalid-feedback">Por favor ingrese su nombre.</div>
                            </div>
                            <div class="form-group mb-4">
                                <input class="form-control" id="email" type="email" placeholder="Correo Electrónico *" required />
                                <div class="invalid-feedback">Por favor ingrese un correo válido.</div>
                            </div>
                            <div class="form-group mb-4">
                                <input class="form-control" id="telefono" type="tel" placeholder="Teléfono *" required />
                                <div class="invalid-feedback">Por favor ingrese su teléfono.</div>
                            </div>
                            <div class="form-group mb-4">
                                <select class="form-control" id="asunto" required>
                                    <option value="" disabled selected>Seleccione un asunto *</option>
                                    <option value="cotizacion">Cotización de materiales</option>
                                    <option value="asesoria">Asesoría técnica</option>
                                    <option value="reclamo">Reclamo o sugerencia</option>
                                    <option value="otros">Otros</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group form-group-textarea mb-4">
                                <textarea class="form-control" id="mensaje" rows="6" placeholder="Detalle su consulta *" required></textarea>
                                <div class="invalid-feedback">Por favor ingrese su mensaje.</div>
                            </div>
                        </div>
                    </div>
                    <div class="text-center">
                        <button class="btn btn-primary btn-xl text-uppercase" type="submit">Enviar Consulta</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
<!-- Modal 1 -->
<div class="portfolio-modal modal fade" id="portfolioModal1" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="close-modal" data-bs-dismiss="modal"><img src="~/assets/img/close-icon.svg" alt="Cerrar modal" /></div>
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <div class="modal-body">
                            <h2 class="text-uppercase">Llave Stilson</h2>
                            <p class="item-intro text-muted">Color Celeste</p>
                            <img class="img-fluid d-block mx-auto" src="~/assets/img/portfolio/1.jpg" alt="Proyecto Hilos" />
                            <p>La llave Stillson (o llave grifa) es una herramienta ajustable con mordazas dentadas que sirve principalmente para apretar o aflojar tuberías y piezas cilíndricas. Es esencial en fontanería, construcción e industria por su capacidad de agarre firme y la gran fuerza que puede aplicar.</p>
                            <button class="btn btn-primary btn-xl text-uppercase" data-bs-dismiss="modal" type="button">
                                <i class="fas fa-times me-1"></i>
                                Cerrar Producto
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

