@model WebFerreteria.Models.Producto

@{
    ViewData["Title"] = "Crear Productos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="card rounded shadow">
        <div class="card-body p-4">
            <h1 class="card-title fw-bold mb-4">Crear Producto</h1> <hr class="mb-4" /> <div class="row">
                <div class="col-md-8 offset-md-2 col-lg-6 offset-lg-3">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="form-group mb-3">
                            <label class="control-label">Categoría</label>
                            <select asp-for="IdCategoria" class="form-control" asp-items="ViewBag.IdCategoria"></select>
                            <span asp-validation-for="IdCategoria" class="text-danger"></span>
                        </div>
                        <div class="form-group mb-3">
                            <label class="control-label">Proveedor</label>
                            <select asp-for="IdProveedor" class="form-control" asp-items="ViewBag.IdProveedor"></select>
                            <span asp-validation-for="IdProveedor" class="text-danger"></span>
                        </div>
                        <div class="form-group mb-3">
                            <label class="control-label">Código</label>
                            <input asp-for="Codigo" class="form-control text-uppercase" />
                            <span asp-validation-for="Codigo" class="text-danger"></span>
                        </div>
                        <div class="form-group mb-3">
                            <label class="control-label">Descripción</label>
                            <input asp-for="Descripcion" class="form-control" />
                            <span asp-validation-for="Descripcion" class="text-danger"></span>
                        </div>
                        <div class="form-group mb-3">
                            <label class="control-label">Precio de Venta</label>
                            <input asp-for="PrecioVenta" type="number" class="form-control" />
                            <span asp-validation-for="PrecioVenta" class="text-danger"></span>
                        </div>
                        <div class="form-group mb-3">
                            <label class="control-label">Saldo</label>
                            <input asp-for="Saldo" type="number" class="form-control" />
                            <span asp-validation-for="Saldo" class="text-danger"></span>
                        </div>
                        <div class="form-group mb-4">
                            <label class="control-label">Unidad de Medida</label>
                            <select asp-for="UnidadMedida" class="form-select">
                                <option disabled selected value="">Seleccione un Elemento</option>
                                <option>Caja</option>
                                <option>Docena</option>
                                <option>Paquete</option>
                                <option>Unidad</option>
                            </select>
                            <span asp-validation-for="UnidadMedida" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2 mb-3">
                            <button type="submit" class="btn btn-warning">
                                <i class="fa-solid fa-floppy-disk"></i> Crear
                            </button>
                        </div>

                        <div class="text-center">
                            <a asp-action="Index"><i class="fa-solid fa-arrow-left"></i> Volver a la Lista</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}