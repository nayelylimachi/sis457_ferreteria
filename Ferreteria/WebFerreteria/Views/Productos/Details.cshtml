@model WebFerreteria.Models.Producto

@{
    ViewData["Title"] = "Detalle Producto";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="card rounded shadow">
        <div class="card-body p-4">
            <h1 class="card-title fw-bold mb-4">Detalle Producto</h1>
                <div class="col-md-8 offset-md-2 col-lg-6 offset-lg-3">
                    <div>
                    <dl class="row">
                        <dt class="col-sm-4">Código</dt>
                        <dd class="col-sm-8">
                            @Html.DisplayFor(model => model.Codigo)
                        </dd>
                        <dt class="col-sm-4">Descripción</dt>
                        <dd class="col-sm-8">
                            @Html.DisplayFor(model => model.Descripcion)
                        </dd>
                        <dt class="col-sm-4">Precio de Venta</dt>
                        <dd class="col-sm-8">
                            @Html.DisplayFor(model => model.PrecioVenta)
                        </dd>
                        <dt class="col-sm-4">Saldo</dt>
                        <dd class="col-sm-8">
                            @Html.DisplayFor(model => model.Saldo)
                        </dd>
                        <dt class="col-sm-4">Unidad de Medida</dt>
                        <dd class="col-sm-8">
                            @Html.DisplayFor(model => model.UnidadMedida)
                        </dd>
                        <dt class="col-sm-4">Usuario Registro</dt>
                        <dd class="col-sm-8">
                            @Html.DisplayFor(model => model.UsuarioRegistro)
                        </dd>
                        <dt class="col-sm-4">Fecha de Registro</dt>
                        <dd class="col-sm-8">
                            @(Model.FechaRegistro.ToLongDateString() + " " + Model.FechaRegistro.ToLongTimeString())
                        </dd>
                        <dt class="col-sm-4">Estado</dt>
                        <dd class="col-sm-8">
                            @(Model.Estado == 1 ? "Activo" : "Inactivo")
                        </dd>
                        <dt class="col-sm-4">Categoría</dt>
                        <dd class="col-sm-8">
                            @Html.DisplayFor(model => model.IdCategoriaNavigation.Nombre)
                        </dd>
                        <dt class="col-sm-4">Proveedor</dt>
                        <dd class="col-sm-8">
                            @Html.DisplayFor(model => model.IdProveedorNavigation.RazonSocial)
                        </dd>
                    </dl>

                    <div class="d-flex justify-content-center gap-3">
                        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning flex-grow-1 text-white">
                            <i class="fa-solid fa-pen-to-square"></i> Editar
                        </a>

                        <div class="text-center">
                            <a asp-action="Index"><i class="fa-solid fa-arrow-left"></i> Volver a la Lista</a>
                        </div>
                    </div>
                    </div>
                </div>
            </div>
        </div>
    </div>



