@model IEnumerable<WebFerreteria.Models.Producto>

@{
    ViewData["Title"] = "Productos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="page-section" id="productos">
    <div class="container">
        <div class="card shadow p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="mb-0">Productos</h2>
                <a asp-action="Create" class="btn btn-primary btn-xl text-uppercase">
                    <i class="fa-solid fa-plus"></i> Crear Nuevo
                </a>
            </div>

            <!-- Buscador -->
            <div class="mb-3">
                <input type="text" id="filtroProducto" class="form-control" placeholder="Buscar producto...">
            </div>

            <!-- Tabla -->
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Código</th>
                            <th>Descripción</th>
                            <th>Precio de Venta</th>
                            <th>Saldo</th>
                            <th>Unidad de Medida</th>
                            <th>Usuario Registro</th>
                            <th>Fecha Registro</th>
                            <th>Estado</th>
                            <th>Categoría</th>
                            <th>Proveedor</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Codigo</td>
                                <td>@item.Descripcion</td>
                                <td>@item.PrecioVenta</td>
                                <td>@item.Saldo</td>
                                <td>@item.UnidadMedida</td>
                                <td>@item.UsuarioRegistro</td>
                                <td>@item.FechaRegistro.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <span class="badge @(item.Estado == 1 ? "bg-success" : "bg-secondary")">
                                        @(item.Estado == 1 ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                                <td>@item.IdCategoriaNavigation?.Nombre</td>
                                <td>@item.IdProveedorNavigation?.RazonSocial</td>
                                <td class="text-center">
                                    <div class="btn-group" role="group" aria-label="Acciones de Fila">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Ver">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="Editar">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                            <i class="fa-solid fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const input = document.getElementById("filtroProducto");
        const filas = document.querySelectorAll("table tbody tr");

        input.addEventListener("keyup", function () {
            const texto = input.value.toLowerCase();

            filas.forEach(fila => {
                const descripcion = fila.children[1].textContent.toLowerCase(); // Columna de descripción
                if (descripcion.includes(texto)) {
                    fila.style.display = "";
                } else {
                    fila.style.display = "none";
                }
            });
        });
    });
</script>
