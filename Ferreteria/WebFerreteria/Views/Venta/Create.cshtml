@model WebFerreteria.Models.ViewModels.VentaViewModel

@{
    ViewData["Title"] = "Registrar Venta";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var productos = ViewBag.Productos;
}

<section class="page-section" id="ventas">
    <div class="container">
        <div class="card shadow p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="mb-0"><i class="fas fa-cart-plus"></i> Registrar Venta</h2>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fa-solid fa-arrow-left"></i> Volver
                </a>
            </div>

            <form asp-action="Create" method="post">
                <div class="row mb-4">
                    <div class="col-md-6">
                        <label class="form-label">Nombre del cliente</label>
                        <input type="hidden" name="Cliente.Id" value="0" />
                        <input type="text" name="Cliente.Nombre" class="form-control" required placeholder="Ingrese el nombre del cliente" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">NIT o CI</label>
                        <input type="text" name="Cliente.Nit" class="form-control" required placeholder="Ingrese el NIT o CI" />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label">Buscar y agregar producto</label>
                    <div class="row g-2">
                        <div class="col-md-10">
                            <select id="selectProducto" class="form-select select2">
                                <option value="">-- Seleccione producto --</option>
                                @foreach (var p in productos)
                                {
                                    <option value="@p.Id" data-precio="@p.PrecioVenta" data-descripcion="@p.Descripcion" data-saldo="@p.Saldo">
                                        @p.Descripcion (Stock: @p.Saldo)
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button type="button" class="btn btn btn-primary w-100" onclick="agregarProducto()">
                                <i class="fa-solid fa-plus"></i> Agregar
                            </button>
                        </div>
                    </div>
                </div>


                <div class="table-responsive mb-4">
                    <table class="table table-hover align-middle" id="tablaDetalle">
                        <thead class="table-dark">
                            <tr>
                                <th>Producto</th>
                                <th>Cantidad</th>
                                <th>Precio</th>
                                <th>Total</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>

                <div class="row justify-content-end">
                    <div class="col-md-6 col-lg-5">
                        <div class="row mb-3 align-items-center">
                            <label class="col-sm-4 col-form-label fw-bold">Total</label>
                            <div class="col-sm-8">
                                <input type="text" id="total" name="Total" class="form-control text-end" readonly />
                            </div>
                        </div>
                        <div class="row mb-3 align-items-center">
                            <label class="col-sm-4 col-form-label fw-bold">Pago</label>
                            <div class="col-sm-8">
                                <input type="number" name="Pago" class="form-control text-end" required onchange="calcularCambio()" />
                            </div>
                        </div>
                        <div class="row mb-4 align-items-center">
                            <label class="col-sm-4 col-form-label fw-bold">Cambio</label>
                            <div class="col-sm-8">
                                <input type="text" id="cambio" class="form-control text-end" readonly />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row mt-4">
                    <div class="col-md-6 d-grid">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="fa-solid fa-floppy-disk"></i> Registrar Venta
                        </button>
                    </div>
                    <div class="col-md-6 d-grid">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-danger btn-lg">
                            <i class="fa-solid fa-xmark"></i> Cancelar
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        let index = 0;

        function agregarProducto() {
            const select = document.getElementById("selectProducto");
            const option = select.selectedOptions[0];
            if (!option.value) return;

            const id = option.value;
            const descripcion = option.dataset.descripcion;
            const precio = parseFloat(option.dataset.precio);
            const saldo = parseFloat(option.dataset.saldo);

            const fila = `
                <tr>
                    <td>
                        ${descripcion}
                        <input type="hidden" name="Detalles[${index}].IdProducto" value="${id}" />
                    </td>
                    <td>
                        <input type="number" name="Detalles[${index}].Cantidad" value="1" min="1" max="${saldo}" class="form-control" onchange="calcularTotal(this)" required />
                    </td>
                    <td>
                        <input type="number" name="Detalles[${index}].PrecioUnitario" value="${precio}" class="form-control" readonly />
                    </td>
                    <td>
                        <input type="text" name="Detalles[${index}].Total" value="${precio.toFixed(2)}" class="form-control" readonly />
                    </td>
                    <td>
                        <button type="button" class="btn btn-danger" onclick="this.closest('tr').remove(); recalcularTotal()">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </td>
                </tr>`;
            document.querySelector("#tablaDetalle tbody").insertAdjacentHTML("beforeend", fila);
            index++;
            recalcularTotal();
        }

        function calcularTotal(input) {
            const fila = input.closest("tr");
            const cantidad = parseFloat(fila.querySelector('[name$=".Cantidad"]').value) || 0;
            const precio = parseFloat(fila.querySelector('[name$=".PrecioUnitario"]').value) || 0;
            fila.querySelector('[name$=".Total"]').value = (cantidad * precio).toFixed(2);
            recalcularTotal();
        }

        function recalcularTotal() {
            let total = 0;
            document.querySelectorAll('[name$=".Total"]').forEach(input => {
                total += parseFloat(input.value) || 0;
            });
            document.getElementById("total").value = total.toFixed(2);
            calcularCambio();
        }

        function calcularCambio() {
            const total = parseFloat(document.getElementById("total").value) || 0;
            const pago = parseFloat(document.querySelector('[name="Pago"]').value) || 0;
            document.getElementById("cambio").value = (pago - total).toFixed(2);
        }

        // Filtro deslizante
        document.addEventListener("DOMContentLoaded", function () {
            const input = document.getElementById("filtroProducto");
            const select = document.getElementById("selectProducto");

            input.addEventListener("keyup", function () {
                const texto = input.value.toLowerCase();
                Array.from(select.options).forEach(opt => {
                    const desc = opt.textContent.toLowerCase();
                    opt.style.display = desc.includes(texto) ? "" : "none";
                });
            });
        });
    </script>
}
